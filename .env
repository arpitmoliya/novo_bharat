# Copy to .env before running `docker compose up`.

# --- Database ---
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=novobharat_admin
DB_USERNAME=novobharat
DB_PASSWORD=novobharat
DB_PORT=3306

# --- Auth ---
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Seeded admin account (used on first boot) ---
ADMIN_EMAIL=admin@novobharat.com
ADMIN_PASSWORD=changeme123

# --- Wiring ---
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:3003/api
