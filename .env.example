# Copy to .env before running `docker compose up` from the repo root.

# --- Database (PostgreSQL) ---
DB_DATABASE=novobharat_admin
DB_USERNAME=novobharat
DB_PASSWORD=novobharat
DB_PORT=5432
# Set to "true" only for external/managed Postgres that requires SSL
# (e.g. Render's external connection string). Internal connections don't need it.
DB_SSL=false

# --- Auth ---
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Seeded super-admin account (used on first boot) ---
ADMIN_EMAIL=superadmin@mailinator.com
ADMIN_PASSWORD=Password@123

# --- Wiring ---
# Allowed CORS origins for the API (comma-separated). Add the public site's
# origin here once it exists, e.g. http://localhost:3000,http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080
# Base API URL baked into the admin panel at build time (browser-reachable).
NEXT_PUBLIC_API_URL=http://localhost:3003/api

# --- Contact form email (optional) ---
# When set, every Contact-page enquiry emails the owner. If left blank, enquiries
# are still saved to the DB (GET /api/inquiries) but no email is sent.
# For Gmail use an App Password (not your account password): smtp.gmail.com, port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives enquiry notifications (defaults to SMTP_USER if blank).
CONTACT_TO=
# From header (defaults to "Novo Bharat Website" <SMTP_USER> if blank).
CONTACT_FROM=
